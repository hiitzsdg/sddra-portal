# South Dumdum Enclave Residents' Association - Environment Configuration

# Flask Session Key
SECRET_KEY=sdera-south-dumdum-enclave-secret-key-2026

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=south_dumdum_enclave

# SMTP Email Configuration (e.g. Gmail SMTP)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_association_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_association_email@gmail.com
SMTP_FROM_NAME=South Dumdum Enclave Residents' Association
