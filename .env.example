# South Dumdum Enclave Residents' Association - Environment Configuration

# Flask Session Key
SECRET_KEY=sdera-south-dumdum-enclave-secret-key-2026

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=south_dumdum_enclave

# SMTP Email Configuration (e.g. Gmail SMTP)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_association_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_association_email@gmail.com
SMTP_FROM_NAME=South Dumdum Enclave Residents' Association

# WhatsApp Integration (Optional: Default is Instant wa.me 1-Click Linking)
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Meta WhatsApp Cloud API (Optional for automated backend sending)
# WHATSAPP_API_TOKEN=EAA...
# WHATSAPP_PHONE_NUMBER_ID=1092837465...
# WHATSAPP_BUSINESS_ACCOUNT_ID=...
# Twilio WhatsApp API (Optional alternative)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Official Society WhatsApp Helplines
CARETAKER_PHONE=+91-983-000-1122
